    "custom.archiveHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档后，任务会从目标选择中移除。历史打卡和植物成长记录会保留，已用的创建次数也会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task will leave the goal picker. Past check-ins, plant growth, and the used creation count are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは目標の選択肢から外れます。チェックイン履歴、植物の成長、使用済みの作成回数は保持されます。"
          }
        }
      }
    },
    "custom.archiveTitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档这个任务？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive this task?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクをアーカイブしますか？"
          }
        }
      }
    },
    "custom.archive": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档任务"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive Task"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクをアーカイブ"
          }
        }
      }
    },
    "custom.pausedHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前方案的可用卡片数已达上限。任务和成长记录仍会保留，升级方案后可恢复使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan’s active card limit is reached. Tasks and growth are saved and can be used again with a higher plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランで使えるカードの上限に達しました。タスクと成長記録は保持され、上位プランで再開できます。"
          }
        }
      }
    },
    "custom.paused": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
