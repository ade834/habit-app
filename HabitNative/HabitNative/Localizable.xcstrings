    "garden.tips.tapBackground.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击空白背景"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景をタップ"
          }
        }
      }
    },
    "garden.tips.tapBackground.desc": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻触任意空白，生成漂浮微光点与光晕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anywhere on the background to release floating glowing orbs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もない場所をタップすると、柔らかな光の粒がふわっと漂います"
          }
        }
      }
    },
    "garden.tips.windDrag.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按拉拽吹风"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press & Drag for Wind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しドラッグで風"
          }
        }
      }
    },
    "garden.tips.windDrag.desc": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续按住并拖动，激发自然八向吹风与花茎晃动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and drag in any direction to stir a natural breeze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押ししながら指を動かすと、花々が風に優しく揺れます"
          }
        }
      }
    },
    "garden.tips.tapFlower.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击花头"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Flowers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お花をタップ"
          }
        }
      }
    },
    "garden.tips.tapFlower.desc": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下查看花卉培育详情，点两下触发随机灵动反应"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once to see growth info; double tap for delightful surprises"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回タップで成長情報を確認、ダブルタップで特別なリアクション"
          }
        }
      }
    },
    "garden.tips.creatures.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
