    "growth.rules.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completing habits builds growth. After 7 full days without a check-in, the garden rests. Growth then gradually decreases, and plants may return to an earlier stage. Check-ins begin recovery; three check-in days end dormancy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録すると成長値が増えます。丸7日間記録がないと庭は休眠し、その後、成長値が徐々に減り、植物が以前の段階に戻ることがあります。記録を再開すると回復が始まり、3日分の記録で休眠を終えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡会积累养成值。连续 7 个完整自然日没有打卡后，花园进入休眠，随后养成值会逐步减少，植物可能回到之前的成长阶段。休眠后完成打卡可以开始恢复；完成 3 个打卡日后退出休眠；恢复期间若再次连续 7 个完整自然日未打卡，恢复会重新计算。"
          }
        }
      }
    },
    "growth.rules.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garden growth"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お庭の成長ルール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花园成长规则"
          }
        }
      }
    },
