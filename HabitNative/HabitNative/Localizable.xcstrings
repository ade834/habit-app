    "reminder.inactivity.body.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have a moment today, take a small step toward a habit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日時間があれば、続けたいことを少しだけやってみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有空的话，做一件想坚持的小事吧。"
          }
