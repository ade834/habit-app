    "恢复已购买的会员": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Purchases"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "订阅说明：月度与年度订阅均不提供试用期。确认购买后将从您的 Apple ID 账户扣款。订阅将自动续费，除非在当前计费周期结束前至少 24 小时关闭自动续订。您可以前往 App Store 账户设置中管理或取消订阅。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription terms: Free trials are not provided for monthly or annual subscriptions. Payment will be charged to your Apple ID account at confirmation of purchase. Subscriptions renew automatically unless auto-renew is turned off at least 24 hours before the end of the current period. You can manage or cancel subscriptions in your App Store account settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期購読のご案内：月額および年額サブスクリプションには無料試用期間はありません。購入確認時にApple IDアカウントに請求されます。現在の請求期間が終了する24時間以上前に自動更新をオフにしない限り、サブスクリプションは自動的に更新されます。App Storeのアカウント設定で管理または解約できます。"
          }
        }
      }
    },
