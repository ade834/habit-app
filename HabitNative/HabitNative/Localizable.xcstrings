    "custom.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张卡片或任务目前无法使用。请返回后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card or task is unavailable. Go back and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードまたはタスクは現在使えません。前の画面に戻ってやり直してください。"
          }
        }
      }
    },
    "custom.error.taskLimit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前方案的任务创建次数已用完。已有任务仍可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve used all task creations for this plan. Existing tasks are still available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランのタスク作成回数を使い切りました。既存のタスクは引き続き使えます。"
          }
        }
      }
    },
    "custom.error.cardLimit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到当前方案的卡片上限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reached your plan’s card limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランのカード上限に達しました。"
          }
        }
      }
    },
    "custom.error.species": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择还未分配的植物。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an unassigned plant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用の植物を選んでください。"
          }
        }
      }
    },
    "custom.error.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
