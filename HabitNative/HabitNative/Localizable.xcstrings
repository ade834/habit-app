    "reminder.permission.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders can help you remember your tasks. Each completed card is a small step toward the person you want to become. Choose your reminders anytime in settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは、やりたいことを思い出す助けになります。カードのタスクを一つずつ終えて、なりたい自分へ少しずつ成長しましょう。通知は設定でいつでも選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒可以帮你记起要做的事，完成卡片任务，让每一次行动都陪你成长为更好的自己。你可以随时在提醒设置中选择需要的提醒。"
          }
        }
      }
    },
    "reminder.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow with gentle reminders"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしいリマインダーとともに成長"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让提醒陪你慢慢成长"
          }
        }
      }
    },
    "reminder.plant.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you have a moment, come complete a habit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間があるときに、習慣をひとつ行いましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有空时，来完成一个习惯吧。"
          }
        }
      }
    },
    "reminder.plant.body.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden would love a visit. Have a moment to care for it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お庭があなたを待っています。少しお世話しませんか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的花园想和你见面了，今天有空来照顾一下吗？"
          }
        }
      }
    },
    "reminder.plant.body.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you have a moment, complete a habit and help your garden grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間があるときに習慣をひとつ行い、庭の成長を見守りましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有空时，完成一个习惯，陪花园继续成长。"
          }
        }
      }
    },
    "reminder.plant.body.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside a little time today to visit your garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、少し時間を取ってお庭を見に行きましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给今天留一点时间，来看看你的花园吧。"
          }
        }
      }
    },
    "reminder.plant.body.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a small habit to bring a little life to your garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな習慣をひとつ行い、お庭に元気を届けましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一个小习惯，为花园添一点生机。"
          }
        }
      }
    },
    "reminder.plant.body.4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想和你的好习惯一起，慢慢长大。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to grow alongside your good habits, one day at a time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの良い習慣と一緒に、ゆっくり大きくなりたいな。"
          }
        }
      }
    },
    "reminder.plant.body.5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我还想继续长大，有空陪我做个小习惯吗？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’d love to keep growing. Have a moment for a small habit?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと大きくなりたいな。時間があったら、小さな習慣を一緒にしよう？"
          }
        }
      }
    },
    "reminder.plant.body.6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想留住现在的模样，来陪我继续成长吧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’d love to keep growing from here. Come grow with me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の姿を大切にしながら、一緒に育っていけたらうれしいな。"
          }
        }
      }
    },
    "reminder.plant.body.7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就算慢慢退回去，我们也可以再一起长大。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if I grow smaller, we can always grow together again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し小さくなっても、また一緒に大きくなれるよ。"
          }
        }
      }
    },
    "reminder.plant.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden needs a little care"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お庭のお世話をしませんか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花园需要一点照顾"
          }
