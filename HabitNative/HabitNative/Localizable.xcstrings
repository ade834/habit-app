    },
    "garden.tips.creatures.desc": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点惊飞换位，再次轻点逃出花园（片刻后飞回）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once to flutter away; tap again to fly off and return later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回タップで飛び立ち、もう1回で外へ逃げ（少し経つと戻ります）"
          }
        }
      }
    },
    "garden.tips.dismissHint": {
