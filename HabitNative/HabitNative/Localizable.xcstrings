{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "sync.membershipHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效会员可开启跨设备同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An active membership is required for cross-device sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な会員登録で端末間同期を利用できます。"
          }
        }
      }
    },
    "sync.membershipRequired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨设备同步需要有效会员。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An active membership is required for cross-device sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末間同期には有効な会員登録が必要です。"
          }
        }
      }
    },
    "sync.membershipRestored": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会员权益恢复后可继续同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync can resume when your membership is restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会員特典が復元されると同期を再開できます。"
          }
        }
      }
    },
    "sync.syncing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在与 iCloud 同步…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing with iCloud…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudと同期中…"
          }
        }
      }
    },
    "sync.complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与 iCloud 同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced with iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudとの同期が完了しました"
          }
        }
      }
    },
    "sync.localClearPaused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机数据已清除。为保护数据，同步已暂停。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was cleared. Sync is paused to protect your data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のデータが削除されました。データ保護のため同期を一時停止しました。"
          }
        }
      }
    },
    "sync.accountChanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账户已变更。为保护数据，同步已暂停。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud account changed. Sync is paused to protect your data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudアカウントが変更されました。データ保護のため同期を一時停止しました。"
          }
        }
      }
    },
    "sync.conflict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备都有未合并的数据。请先保留各自数据，稍后处理合并。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices have data that cannot yet be merged. Keep both sets of data and resolve it later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末に未統合のデータがあります。両方のデータを保持し、後で統合してください。"
          }
        }
      }
    },
    "sync.localDataPresent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已有数据，暂不能安全合并。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device already has data and cannot be merged safely yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には既存データがあるため、安全に統合できません。"
          }
        }
      }
    },
    "sync.checkNeeded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步数据需要检查，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sync data needs attention. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期データの確認が必要です。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "sync.signIn": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在系统设置中登录 iCloud。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「設定」でiCloudにサインインしてください。"
          }
        }
      }
    },
    "sync.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步暂时不可用，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is temporarily unavailable. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期を一時的に利用できません。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "sync.retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        }
      }
    },
    "sync.available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选开启"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で有効化"
          }
        }
      }
    },
    "sync.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 跨设备同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud端末間同期"
          }
        }
      }
    },
    "ai.review.month.membership": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly AI reviews are available to members"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月次AIレビューは会員限定です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 月复盘为会员功能"
          }
        }
      }
    },
    "custom.paywallDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁更多自定义卡片、更大的植物庭院和更多 AI 周复盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock more custom cards, a larger garden, and more AI weekly reviews."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムカードを増やし、庭を広げ、AI週間レビューをもっと利用できます。"
          }
        }
      }
    },
    "完成打卡": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成打卡"
          }
