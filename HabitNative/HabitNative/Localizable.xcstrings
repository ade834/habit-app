    },
    "reminder.inactivity.body.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a little time for yourself and start with one small habit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のために少し時間を作り、小さな習慣から始めましょう。"
          }
