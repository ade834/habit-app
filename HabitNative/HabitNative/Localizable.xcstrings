      }
    },
    "custom.guide": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加任务后，可在「今天」选择它。完成一次打卡，所属卡片的植物就增加 1 点养成值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a task, then select it in Today. Each check-in adds 1 growth point to the card’s plant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加したら「今日」で選べます。チェックインするたびに、カードの植物の成長値が1増えます。"
          }
        }
      }
    },
    "custom.prompt": {
