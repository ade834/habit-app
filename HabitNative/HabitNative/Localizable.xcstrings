        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给自己一点时间，从一个小习惯开始。"
          }
        }
      }
    },
    "reminder.inactivity.body.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back when you’re ready and continue at your own pace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら戻って、自分のペースで続けましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
